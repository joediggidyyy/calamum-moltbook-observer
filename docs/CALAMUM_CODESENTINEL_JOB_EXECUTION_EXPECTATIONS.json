{
  "meta": {
    "type": "operations_policy",
    "version": "1.0.6",
    "id": "CALAMUM_CODESENTINEL_JOB_EXECUTION_EXPECTATIONS_20260212",
    "scope": "projects/calamum-moltbook-observer",
    "owner": "ORACL-Prime",
    "primary_stakeholder_approver": "joediggidyyy",
    "status": "ACTIVE",
    "last_updated_utc": "2026-02-21"
  },
  "purpose": "Define observer-scoped job execution expectations when CodeSentinel is the job orchestrator (names-only, fail-closed), with strict scope separation from non-observer Calamum systems.",
  "ssot": {
    "tasks_file": "operations/tasks.json",
    "queststack_parse_surface": "projects/calamum-moltbook-observer/queststacks/*.md"
  },
  "scope_identity": {
    "project_runtime_label": "observer",
    "runtime_cli_surface": "observerctl",
    "scope_rule": "Observer runtime surfaces must use observer naming and must not rely on codesentinel-scoped process surfaces.",
    "legacy_identifier_policy": "Historical CALAMUM_* artifact IDs remain valid for lineage and traceability; new runtime interfaces must use observer naming.",
    "forbidden_runtime_labels": [
      "calamum",
      "calamumctl"
    ],
    "runtime_mode_model": {
      "source_axis": [
        "sim",
        "real"
      ],
      "mode_axis": [
        "watch",
        "canary",
        "live",
        "honeypot"
      ],
      "note": "The term 'live' is reserved for interaction posture under mode_axis; real target sourcing uses source='real'."
    }
  },
  "gate_contract": {
    "gate": "PRE_JOB",
    "policy": "fail_closed",
    "notes": [
      "PRE_JOB parses QuestStack markdown to locate required artifacts.",
      "The first occurrence of 'jobs/' in the QuestStack is treated as the repo-root job stub link."
    ],
    "required_artifacts": [
      {
        "name": "questframe_spec",
        "path_prefix": "projects/calamum-moltbook-observer/questframes/",
        "path_pattern_hint": "QF-*.json"
      },
      {
        "name": "job_doc_stub_repo_root",
        "path_prefix": "jobs/",
        "path_pattern_hint": "CALAMUM_JOB_*.md"
      },
      {
        "name": "job_report",
        "path_prefix": "docs/reports/operations/",
        "path_pattern_hint": "JOB_REPORT_<QS-ID>.md"
      },
      {
        "name": "queststack_log",
        "path_prefix": "logs/queststack/",
        "path_pattern_hint": "<QS-ID>_log.md"
      },
      {
        "name": "queststack_evidence",
        "path_prefix": "logs/queststack/",
        "path_pattern_hint": "<QS-ID>_evidence.jsonl"
      }
    ],
    "recommended_artifacts": [
      {
        "name": "gate_evidence_stream",
        "path": "logs/behavioral/gates/gate_events.jsonl"
      }
    ]
  },
  "artifact_spine": {
    "queststack_must_link": [
      "projects/calamum-moltbook-observer/questframes/<QF-ID>.json",
      "jobs/<CALAMUM_JOB_xxxx...>.md",
      "projects/calamum-moltbook-observer/jobs/<CALAMUM_JOB_xxxx...>.md",
      "projects/calamum-moltbook-observer/jobs/<CALAMUM_JOB_xxxx...>.json",
      "docs/reports/operations/JOB_REPORT_<QS-ID>.md",
      "logs/queststack/<QS-ID>_log.md",
      "logs/queststack/<QS-ID>_evidence.jsonl"
    ],
    "conflict_resolution": {
      "project_locality": {
        "must_live_under_project_tree": [
          "projects/calamum-moltbook-observer/local_untracked/",
          "projects/calamum-moltbook-observer/logs/"
        ]
      },
      "system_level_evidence": {
        "must_live_at_repo_root": [
          "docs/reports/operations/",
          "logs/queststack/",
          "logs/behavioral/gates/"
        ]
      }
    }
  },
  "directory_governance": {
    "policy": "no_new_directories_without_explicit_authorization",
    "scope": "projects/calamum-moltbook-observer/**",
    "rules": [
      "No new directories may be created without explicit operator authorization.",
      "Authorization must be recorded in the active QuestStack or job report before directory creation.",
      "When an authorized directory is created, update PROJECT_MANIFEST.json layout metadata in the same change set.",
      "Unapproved directory creation is a fail-closed policy violation and must be remediated before job close."
    ]
  },
  "lifecycle": {
    "start": "codesentinel job start <task_id>",
    "close": "codesentinel job close <task_id>",
    "post_close_required": [
      "codesentinel memory health --json"
    ],
    "runtime_diagnostic_refresh": {
      "policy": "refresh watchdog instance before runtime diagnostics when needed",
      "default_easiest_path": "restart dashboard stack via launch_ghost_console.ps1 (headless/browser-skip for operator runs)",
      "note": "dashboard restart is easiest but not exclusive; alternate approved refresh methods may be used",
      "runtime_script": "projects/calamum-moltbook-observer/tools/audit_runtime_artifacts.py",
      "options": {
        "watchdog_refresh": [
          "pre",
          "on-stale"
        ],
        "watchdog_refresh_method": [
          "dashboard-restart",
          "custom-command"
        ]
      }
    },
    "observerctl_contract": {
      "policy": "observerctl is a standalone observer-scoped CLI and must not depend on CodeSentinel runtime processes.",
      "allowed_dependencies": [
        "project-local observer modules",
        "project-local logs and control artifacts",
        "environment variables"
      ],
      "forbidden_dependencies": [
        "codesentinel process orchestration",
        "codesentinel CLI command surfaces",
        "codesentinel session-memory internals"
      ],
      "gated_job_readiness": [
        "observerctl preflight emits names-only status packet",
        "observerctl gate-check emits go/no-go with reason codes",
        "observerctl evidence packet references queststack/job artifacts by path",
        "observerctl output remains compatible with PRE_JOB/POST_JOB fail-closed semantics",
        "observerctl gate/evidence outputs include run linkage fields: run_id, posture_trigger_id, posture_trigger, security_report_ref"
      ]
    }
  },
  "ops_posture_policy": {
    "trigger_posture_by_mode": {
      "watch": "isolation",
      "canary": "isolation",
      "live": "lockdown",
      "honeypot": "lockdown"
    },
    "isolation_profile": {
      "required_reactions": [
        "quarantine container",
        "block ingress and egress (no data in or out)",
        "suspend collector/interactor runtime",
        "allow names-only local health and evidence logging only"
      ]
    },
    "lockdown_profile": {
      "required_reactions": [
        "apply all isolation reactions",
        "increase watchdog and observer heartbeat cadence",
        "tighten stale heartbeat threshold",
        "increase baseline validation cadence",
        "freeze non-essential writes except append-only evidence",
        "deny promotion transitions until recovery checks pass"
      ],
      "suggested_parameters": {
        "heartbeat_interval_seconds": "3-5",
        "stale_threshold_missed_beats": 2,
        "baseline_validation_interval_seconds": "30-60",
        "recovery_clean_cycles_required": 3
      }
    },
    "gate_enforcement": {
      "policy": "fail_closed",
      "required_checks": [
        "watchdog_trigger_posture_valid",
        "heartbeat_rate_escalated_for_lockdown",
        "baseline_validation_rate_escalated_for_lockdown",
        "run_security_report_linked"
      ],
      "failure_reason_codes": [
        "critical_check_failed:watchdog_trigger_posture_invalid",
        "critical_check_failed:lockdown_heartbeat_rate_not_escalated",
        "critical_check_failed:lockdown_baseline_rate_not_escalated",
        "critical_check_failed:run_security_report_missing"
      ]
    }
  },
  "data_contract": {
    "required_linkage_fields": [
      "run_id",
      "posture_trigger_id",
      "posture_trigger",
      "security_report_ref"
    ],
    "posture_trigger_allowed_values": [
      "isolation",
      "lockdown"
    ],
    "rule": "All collection, gate, and evidence records must carry required linkage fields to support run-level security traceability."
  },
  "publication_requirements": {
    "standard": "doctoral_publish_grade",
    "required_packets": [
      {
        "name": "provenance",
        "minimum_fields": [
          "artifact_path",
          "artifact_sha256",
          "generated_at_utc",
          "producer_process",
          "upstream_inputs"
        ]
      },
      {
        "name": "methodology",
        "minimum_fields": [
          "sampling_strategy",
          "runtime_constraints",
          "data_handling_invariants",
          "failure_modes",
          "repro_steps"
        ]
      },
      {
        "name": "process_log",
        "minimum_fields": [
          "phase",
          "decision",
          "rationale",
          "evidence_refs",
          "approver_checkpoint"
        ]
      }
    ],
    "quality_gates": [
      "names-only compliance",
      "reproducibility from documented steps",
      "explicit methodology-to-evidence mapping"
    ]
  },
  "security": {
    "names_only": true,
    "icmp_assumed_disabled": true,
    "naming_convention": {
      "canonical_roles": {
        "KEYSMITH": "key mint/bootstrap lane (Job 0018 lineage)",
        "KEYMASTER": "key retrieval/live-readiness lane (Job 0021 lineage)"
      },
      "rule": "KEYSMITH and KEYMASTER are distinct roles and must not be used interchangeably in ids, summaries, status reasons, or gate-critical artifact references.",
      "casing": {
        "preferred": [
          "KEYSMITH",
          "KEYMASTER"
        ],
        "allowed_human_readable": [
          "Keysmith",
          "Keymaster"
        ]
      }
    },
    "secrets": {
      "never_print_or_log": true,
      "never_write_tracked": true,
      "live_collection_key": {
        "env_var": "MOLTBOOK_API_KEY",
        "approved_acquisition": "KEYSMITH (sandbox minting; claim_url-only human ceremony; sealed-drop import into VAULT/OS secret storage; no host-vendor interaction outside sandbox)",
        "hard_stops": [
          "api key printed to stdout/stderr",
          "api key written to tracked path",
          "human copy/paste or viewing required"
        ]
      }
    }
  }
}
