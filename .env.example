# Calamum environment template
# Copy to .env (local only) OR export in your shell.
# Do not commit secrets.

# Required for signed obfuscated telemetry
CALAMUM_DATA_SIGNING_KEY=your_key_here

# Dev-only: allow an insecure built-in signing key when CALAMUM_DATA_SIGNING_KEY
# is not set. Do NOT use in production.
# CALAMUM_ALLOW_DEV_SIGNING_KEY=1

# Optional overrides (normally discovered automatically)
# CALAMUM_LOG_DIR=projects/calamum-moltbook-observer/logs
# CALAMUM_DATA_DIR=projects/calamum-moltbook-observer/logs/data/calamum
# CALAMUM_CONTROL_DIR=projects/calamum-moltbook-observer/logs/control
# CALAMUM_HEALTH_DIR=projects/calamum-moltbook-observer/logs/health

# External integration (if used)
# MOLTBOOK_API_KEY=your_key_here

# Source selector for the observer agent:
# - sim: local synthetic generator (default)
# - live: Moltbook GET-only API client (requires MOLTBOOK_API_KEY)
# CALAMUM_MOLTBOOK_SOURCE=sim

# Optional override for the live client base URL (default shown)
# MOLTBOOK_HOST=https://api.moltbook.com/v1
