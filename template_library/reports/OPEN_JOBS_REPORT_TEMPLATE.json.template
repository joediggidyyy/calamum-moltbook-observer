    "timestamp",
    "status_filter_list",
    "owners",
    "priorities",
    "sort_key",
    "sort_direction",
    "limit",
    "job.id",
    "job.summary",
    "job.owner",
    "job.priority",
    "job.status",
    "job.category",
    "job.due_within_hours"
  ],
  "notes": "This template is often pasted into completed snapshots. Canonical lives in VAULT; doc-side copies should be pointers only."
}
